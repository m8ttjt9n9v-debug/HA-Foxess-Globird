{
  "schema_version": 1,
  "extension": "maintenance_v1",
  "scope": "Separate host-status and optional explicitly configured Fleet-hub extension; not part of the 124 retained canonical EntitySpec inventory.",
  "identity_rule": "Entry-scoped unique IDs are stable. Registry names, entity IDs, icons, areas, visibility and enabled state remain user-owned. Site keys come from trusted backend configuration, not discovered electrical assumptions.",
  "entity_pattern_count": 5,
  "entity_patterns": [
    {
      "class": "MaintenanceStatus",
      "scope": "host",
      "platform": "sensor",
      "key_template": "maintenance",
      "unique_id_template": "{config_entry_id}_maintenance",
      "default_entity_id_template": "sensor.home_energy_maintenance"
    },
    {
      "class": "MaintenanceStatus",
      "scope": "configured_fleet_site",
      "platform": "sensor",
      "key_template": "fleet_{site_key}_maintenance",
      "unique_id_template": "{config_entry_id}_fleet_{site_key}_maintenance",
      "default_entity_id_template": "sensor.home_energy_fleet_{site_key}_maintenance"
    },
    {
      "class": "MaintenanceVersion",
      "scope": "configured_fleet_site",
      "platform": "select",
      "key_template": "fleet_{site_key}_release",
      "unique_id_template": "{config_entry_id}_fleet_{site_key}_release",
      "default_entity_id_template": "select.home_energy_fleet_{site_key}_release"
    },
    {
      "class": "MaintenanceButton",
      "scope": "configured_fleet_site",
      "platform": "button",
      "key_template": "fleet_{site_key}_update_and_restart",
      "unique_id_template": "{config_entry_id}_fleet_{site_key}_update_and_restart",
      "default_entity_id_template": "button.home_energy_fleet_{site_key}_update_and_restart"
    },
    {
      "class": "MaintenanceButton",
      "scope": "configured_fleet_site",
      "platform": "button",
      "key_template": "fleet_{site_key}_restart",
      "unique_id_template": "{config_entry_id}_fleet_{site_key}_restart",
      "default_entity_id_template": "button.home_energy_fleet_{site_key}_restart"
    }
  ],
  "node_status_attributes": [
    "action",
    "available_versions",
    "backup_id",
    "backup_verified",
    "blockers",
